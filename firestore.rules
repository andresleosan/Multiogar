rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return !isSignedIn()
        ? null
        : request.auth.token.role is string
          ? request.auth.token.role
          : request.auth.token.email == 'admin@admin.com' ||
              request.auth.token.email == 'admin@multiogar.com'
            ? 'superadmin'
            : request.auth.token.email == 'vendedor@vendedor.com'
              ? 'vendedor'
              : 'cliente';
    }

    function isSuperAdmin() {
      return role() == 'superadmin';
    }

    function isStaff() {
      return role() == 'superadmin' || role() == 'vendedor';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (role() == 'vendedor' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stock', 'updatedAt']));
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isStaff();
    }

    match /chats/{chatId} {
      allow read, write: if isStaff();

      match /messages/{messageId} {
        allow read, write: if isStaff();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
